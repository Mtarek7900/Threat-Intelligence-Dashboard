# Copy to .env and fill in the keys you have. Never commit .env.
# A Source without a key is shown as Not Checked (missing API key).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Optional: Verdict thresholds (defaults shown). VirusTotal gives a Malicious Signal when at least
# this many engines flag the Indicator, and a Suspicious one from the lower number up to that.
# VERDICT_VIRUSTOTAL_MALICIOUS_ENGINES=3
# VERDICT_VIRUSTOTAL_SUSPICIOUS_ENGINES=1
